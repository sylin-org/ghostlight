{
  "$schema": "https://raw.githubusercontent.com/modelcontextprotocol/mcpb/main/schemas/mcpb-manifest-v0.3.schema.json",
  "manifest_version": "0.3",
  "name": "ghostlight",
  "display_name": "Ghostlight",
  "version": "1.3.4",
  "description": "Use signed-in Chromium from Claude with visible local execution and optional policy and audit.",
  "long_description": "Ghostlight gives Claude a visible tab group in the signed-in Chromium profile you already use. The persistent authority, protocol-versioned MCP edge, browser relay, and extension run locally. There is no Ghostlight account, telemetry, or hosted control plane. Ghostlight in Browser from the Chrome Web Store is required.",
  "author": {
    "name": "Sylin",
    "email": "hello@sylin.org",
    "url": "https://github.com/sylin-org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sylin-org/ghostlight.git"
  },
  "homepage": "https://sylin.org/ghostlight/",
  "documentation": "https://github.com/sylin-org/ghostlight/blob/main/docs/guides/installation.md",
  "support": "https://github.com/sylin-org/ghostlight/issues",
  "icon": "icon.png",
  "server": {
    "type": "node",
    "entry_point": "server/launch.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/server/launch.js"
      ],
      "env": {}
    }
  },
  "tools_generated": true,
  "keywords": [
    "browser",
    "automation",
    "chromium",
    "governance",
    "audit"
  ],
  "license": "Apache-2.0 OR MIT",
  "privacy_policies": [
    "https://sylin.org/ghostlight/privacy/"
  ],
  "compatibility": {
    "platforms": [
      "win32"
    ],
    "runtimes": {
      "node": ">=18.0.0"
    }
  }
}
