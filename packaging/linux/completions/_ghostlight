#compdef ghostlight
# SPDX-License-Identifier: Apache-2.0 OR MIT
# Zsh completion for ghostlight.
#
# The command and policy command lists below are checked against the command line's own lists,
# and the client list against the agent catalog, by tests in the orchestrator. Adding a
# subcommand, a policy command or an agent without adding it here fails those tests.

_ghostlight() {
    local -a ghostlight_commands=(open install uninstall doctor status call diagnostics policy update)
    local -a ghostlight_policy_commands=(validate migrate explain simulate keygen pubkey sign publish)
    local -a ghostlight_clients=(codex claude-code claude-desktop cursor vscode windsurf devin zed zcode opencode crush copilot-cli cline kiro qwen-code junie kilo-code goose continue antigravity cline-cli cline-vscode cline-cursor cline-windsurf)

    if (( CURRENT == 2 )); then
        _describe -t commands 'ghostlight command' ghostlight_commands
        return
    fi

    # In zsh completion, words[1] is the executable and words[2] is the subcommand. Capture that
    # choice, then give _arguments the subcommand context it expects.
    local command=$words[2]
    words=("${(@)words[2,-1]}")
    (( CURRENT-- ))
    case $command in
        install)
            _arguments \
                '--dry-run[Show changes without writing them]' \
                '--browser[Select one supported browser]:browser:(chrome edge brave chromium)' \
                '--all-browsers[Select every supported browser]' \
                '*--client[Select an agent, or one host of it]:client:compadd -a ghostlight_clients' \
                '--all-clients[Include clients not currently detected]' \
                '--no-clients[Leave MCP client configuration unchanged]' \
                '--no-open[Do not open the Ghostlight window]'
            ;;
        uninstall)
            _arguments \
                '--dry-run[Show changes without writing them]' \
                '--browser[Select one supported browser]:browser:(chrome edge brave chromium)' \
                '*--client[Select an agent, or one host of it]:client:compadd -a ghostlight_clients'
            ;;
        doctor)
            _arguments \
                '--json[Print one JSON document]' \
                '--fix[Apply ownership-safe repairs]' \
                '--verbose[Accepted and ignored]'
            ;;
        status)
            _arguments '--json[Print one JSON document]'
            ;;
        update)
            _arguments '--install[Install the newer release the check finds]'
            ;;
        call)
            _arguments \
                '--json[Print the structured result]' \
                '--stdin[Run a batch over one session]' \
                '--output[Write bounded content to a file]:file:_files' \
                '--catalog[List the available browser tools]' \
                '(-h --help)'{-h,--help}'[Show the usage of call]'
            ;;
        policy)
            _values 'policy command' $ghostlight_policy_commands
            ;;
    esac
}

_ghostlight "$@"
