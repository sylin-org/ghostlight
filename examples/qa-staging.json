{
  "schema": 3,
  "name": "QA staging",
  "version": "1",
  "grants": [
    {
      "id": "staging-sites",
      "hosts": {
        "allow": ["geisinger.org", "*.geisinger.org"],
        "deny": ["admin.geisinger.org"]
      },
      "allowed": ["read", "action", "write"]
    }
  ],
  "config": [
    {
      "key": "browser.tabs.allow_close",
      "value": false,
      "level": "mandatory"
    }
  ]
}
