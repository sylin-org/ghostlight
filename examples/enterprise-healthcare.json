{
  "schema": 3,
  "name": "Healthcare workspace",
  "version": "1",
  "grants": [
    {
      "id": "approved-workspaces",
      "description": "Ordinary work in approved organization applications.",
      "hosts": {
        "allow": [
          "servicenow.geisinger.org",
          "epic.geisinger.org",
          "confluence.geisinger.org",
          "sharepoint.geisinger.org"
        ],
        "deny": ["admin.geisinger.org"]
      },
      "allowed": ["read", "action", "write"]
    }
  ],
  "config": [
    {
      "key": "browser.tabs.allow_close",
      "value": false,
      "level": "mandatory"
    }
  ]
}
