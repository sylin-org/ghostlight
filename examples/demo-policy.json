{
  "schema": 3,
  "name": "Ghostlight site demo",
  "version": "1",
  "grants": [
    {
      "id": "ghostlight-site",
      "hosts": {
        "allow": ["sylin.org", "*.sylin.org"]
      },
      "allowed": ["read", "action", "write", "execute"]
    }
  ],
  "config": [
    {
      "key": "browser.tabs.allow_close",
      "value": false,
      "level": "mandatory"
    }
  ]
}
